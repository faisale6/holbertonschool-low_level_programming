#include "main.h"
/**
 * print_sign(int n) - prints the sign of a number
 *
 * @n: Character to check
 *
 * Return: 1 prints + if n is greater than 0
 * Return: 0 prints 0 if n is 0
 * Return: -1 prints - if n is less than 0
 */

int print_sign(int n)
{
if (n > 0)
{
_putchar('+');
return (1);
}

if (n < 0)
{
_putchar('-');
return (-1);
}
_putchar('0');
return (0);
}
